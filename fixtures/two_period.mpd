<?xml version="1.0" encoding="UTF-8"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011"
     id="two-period-events"
     type="static"
     profiles="urn:mpeg:dash:profile:isoff-live:2011"
     availabilityStartTime="2026-01-01T00:00:00Z"
     publishTime="2026-01-01T00:00:00Z"
     mediaPresentationDuration="PT20S"
     minimumUpdatePeriod="PT0S">
  <UTCTiming schemeIdUri="urn:mpeg:dash:utc:direct:2014"
             value="2026-01-01T00:00:07.000Z"/>

  <Period id="p0" start="PT0S" duration="PT10S">
    <EventStream schemeIdUri="urn:example:boundary"
                 value="main"
                 timescale="1000"
                 presentationTimeOffset="0">
      <Event id="1001" presentationTime="2000" duration="1000">p0-before</Event>
      <Event id="1002" presentationTime="9000" duration="3000">cross-period</Event>
      <Event id="1004" presentationTime="5000" duration="500">expired-before-switch</Event>
    </EventStream>
  </Period>

  <Period id="p1" start="PT10S" duration="PT10S">
    <EventStream schemeIdUri="urn:example:boundary"
                 value="main"
                 timescale="1000"
                 presentationTimeOffset="10000">
      <Event id="1002" presentationTime="9000" duration="3000">cross-period repeat</Event>
      <Event id="1003" presentationTime="10000" duration="2000">starts-at-boundary</Event>
      <Event id="1004" presentationTime="5000" duration="500">stale repeat</Event>
      <Event id="1005" presentationTime="12000" duration="1000">p1-after</Event>
    </EventStream>
  </Period>
</MPD>
