prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include

Name: absl_status_matchers
Description: Abseil status_matchers library
URL: https://abseil.io/
Version: 20260107
Requires: absl_base = 20260107, absl_status = 20260107, absl_statusor = 20260107, absl_strings = 20260107
Libs: -L${libdir}  -labsl_status_matchers -Wl,--push-state,--as-needed -latomic -Wl,--pop-state
Cflags: -I${includedir} -DNOMINMAX
