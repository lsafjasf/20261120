prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include

Name: absl_spy_hash_state
Description: Abseil spy_hash_state library
URL: https://abseil.io/
Version: 20260107
Requires: absl_hash = 20260107, absl_strings = 20260107, absl_str_format = 20260107, absl_weakly_mixed_integer = 20260107
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
