prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include

Name: absl_heterogeneous_lookup_testing
Description: Abseil heterogeneous_lookup_testing library
URL: https://abseil.io/
Version: 20260107
Requires: absl_config = 20260107, absl_test_instance_tracker = 20260107
Libs: -L${libdir}  -Wl,--push-state,--as-needed -latomic -Wl,--pop-state
Cflags: -I${includedir} -DNOMINMAX
