prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include

Name: absl_random_internal_mock_validators
Description: Abseil random_internal_mock_validators library
URL: https://abseil.io/
Version: 20260107
Requires: absl_random_internal_iostream_state_saver = 20260107, absl_random_internal_uniform_helper = 20260107, absl_config = 20260107, absl_raw_logging_internal = 20260107, absl_strings = 20260107, absl_string_view = 20260107
Libs: -L${libdir}  -Wl,--push-state,--as-needed -latomic -Wl,--pop-state
Cflags: -I${includedir} -DNOMINMAX
