prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include

Name: absl_random_mocking_bit_gen
Description: Abseil random_mocking_bit_gen library
URL: https://abseil.io/
Version: 20260107
Requires: absl_config = 20260107, absl_core_headers = 20260107, absl_fast_type_id = 20260107, absl_flat_hash_map = 20260107, absl_raw_logging_internal = 20260107, absl_random_internal_mock_helpers = 20260107, absl_random_random = 20260107, absl_type_traits = 20260107, absl_utility = 20260107
Libs: -L${libdir}  -Wl,--push-state,--as-needed -latomic -Wl,--pop-state
Cflags: -I${includedir} -DNOMINMAX
