prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include

Name: absl_absl_vlog_is_on
Description: Abseil absl_vlog_is_on library
URL: https://abseil.io/
Version: 20260107
Requires: absl_vlog_config_internal = 20260107, absl_config = 20260107, absl_core_headers = 20260107, absl_strings = 20260107
Libs: -L${libdir}  -Wl,--push-state,--as-needed -latomic -Wl,--pop-state
Cflags: -I${includedir} -DNOMINMAX
