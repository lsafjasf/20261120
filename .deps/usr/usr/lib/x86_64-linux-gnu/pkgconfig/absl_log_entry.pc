prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include

Name: absl_log_entry
Description: Abseil log_entry library
URL: https://abseil.io/
Version: 20260107
Requires: absl_config = 20260107, absl_core_headers = 20260107, absl_log_internal_config = 20260107, absl_log_internal_proto = 20260107, absl_log_severity = 20260107, absl_span = 20260107, absl_strings = 20260107, absl_time = 20260107
Libs: -L${libdir}  -labsl_log_entry -Wl,--push-state,--as-needed -latomic -Wl,--pop-state
Cflags: -I${includedir} -DNOMINMAX
