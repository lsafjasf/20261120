prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include

Name: absl_container_memory
Description: Abseil container_memory library
URL: https://abseil.io/
Version: 20260107
Requires: absl_config = 20260107, absl_hash = 20260107, absl_memory = 20260107, absl_type_traits = 20260107, absl_utility = 20260107
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
