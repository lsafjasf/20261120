prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include

Name: absl_no_destructor
Description: Abseil no_destructor library
URL: https://abseil.io/
Version: 20260107
Requires: absl_config = 20260107, absl_nullability = 20260107
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
