prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include

Name: absl_flags_commandlineflag_internal
Description: Abseil flags_commandlineflag_internal library
URL: https://abseil.io/
Version: 20260107
Requires: absl_config = 20260107, absl_dynamic_annotations = 20260107, absl_fast_type_id = 20260107
Libs: -L${libdir}  -labsl_flags_commandlineflag_internal -Wl,--push-state,--as-needed -latomic -Wl,--pop-state
Cflags: -I${includedir} -DNOMINMAX
