prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include

Name: absl_log
Description: Abseil log library
URL: https://abseil.io/
Version: 20260107
Requires: absl_log_internal_log_impl = 20260107, absl_vlog_is_on = 20260107
Libs: -L${libdir}  -Wl,--push-state,--as-needed -latomic -Wl,--pop-state
Cflags: -I${includedir} -DNOMINMAX
