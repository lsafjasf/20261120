prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include

Name: absl_cordz_test_helpers
Description: Abseil cordz_test_helpers library
URL: https://abseil.io/
Version: 20260107
Requires: absl_config = 20260107, absl_cord = 20260107, absl_cord_internal = 20260107, absl_cordz_info = 20260107, absl_cordz_sample_token = 20260107, absl_cordz_statistics = 20260107, absl_cordz_update_tracker = 20260107, absl_core_headers = 20260107, absl_nullability = 20260107, absl_strings = 20260107
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
