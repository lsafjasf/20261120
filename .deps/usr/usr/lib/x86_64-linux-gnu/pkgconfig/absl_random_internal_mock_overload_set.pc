prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include

Name: absl_random_internal_mock_overload_set
Description: Abseil random_internal_mock_overload_set library
URL: https://abseil.io/
Version: 20260107
Requires: absl_config = 20260107, absl_random_mocking_bit_gen = 20260107, absl_random_internal_mock_helpers = 20260107
Libs: -L${libdir}  -Wl,--push-state,--as-needed -latomic -Wl,--pop-state
Cflags: -I${includedir} -DNOMINMAX
