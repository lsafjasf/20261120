prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include

Name: absl_bounded_utf8_length_sequence
Description: Abseil bounded_utf8_length_sequence library
URL: https://abseil.io/
Version: 20260107
Requires: absl_bits = 20260107, absl_config = 20260107
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
