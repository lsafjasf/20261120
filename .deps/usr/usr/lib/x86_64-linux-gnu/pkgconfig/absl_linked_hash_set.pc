prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include

Name: absl_linked_hash_set
Description: Abseil linked_hash_set library
URL: https://abseil.io/
Version: 20260107
Requires: absl_container_common = 20260107, absl_config = 20260107, absl_core_headers = 20260107, absl_flat_hash_set = 20260107
Libs: -L${libdir}  -Wl,--push-state,--as-needed -latomic -Wl,--pop-state
Cflags: -I${includedir} -DNOMINMAX
