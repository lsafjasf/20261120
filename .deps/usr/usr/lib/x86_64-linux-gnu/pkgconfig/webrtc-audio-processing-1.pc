prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib/x86_64-linux-gnu

Name: webrtc-audio-processing-1
Description: WebRTC Audio Processing library
Version: 1.3
Requires: absl_base
Requires.private: absl_flags, absl_strings, absl_synchronization, absl_bad_optional_access
Libs: -L${libdir} -lwebrtc-audio-processing-1
Libs.private: -lrt -pthread
Cflags: -I${includedir}/webrtc-audio-processing-1 -DWEBRTC_LIBRARY_IMPL -DWEBRTC_POSIX
