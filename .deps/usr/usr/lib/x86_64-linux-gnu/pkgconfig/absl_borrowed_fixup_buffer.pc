prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include

Name: absl_borrowed_fixup_buffer
Description: Abseil borrowed_fixup_buffer library
URL: https://abseil.io/
Version: 20260107
Requires: absl_config = 20260107, absl_core_headers = 20260107, absl_hash = 20260107, absl_malloc_internal = 20260107
Libs: -L${libdir}  -labsl_borrowed_fixup_buffer -Wl,--push-state,--as-needed -latomic -Wl,--pop-state
Cflags: -I${includedir} -DNOMINMAX
