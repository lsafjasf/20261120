prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include

Name: absl_debugging
Description: Abseil debugging library
URL: https://abseil.io/
Version: 20260107
Requires: absl_stacktrace = 20260107, absl_leak_check = 20260107
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
