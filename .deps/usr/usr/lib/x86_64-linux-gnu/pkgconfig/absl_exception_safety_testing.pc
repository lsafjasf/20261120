prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include

Name: absl_exception_safety_testing
Description: Abseil exception_safety_testing library
URL: https://abseil.io/
Version: 20260107
Requires: absl_config = 20260107, absl_pretty_function = 20260107, absl_memory = 20260107, absl_meta = 20260107, absl_strings = 20260107, absl_utility = 20260107
Libs: -L${libdir}  -labsl_exception_safety_testing 
Cflags: -I${includedir} -DNOMINMAX
