prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include

Name: absl_cord_rep_test_util
Description: Abseil cord_rep_test_util library
URL: https://abseil.io/
Version: 20260107
Requires: absl_config = 20260107, absl_cord_internal = 20260107, absl_raw_logging_internal = 20260107, absl_strings = 20260107
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
