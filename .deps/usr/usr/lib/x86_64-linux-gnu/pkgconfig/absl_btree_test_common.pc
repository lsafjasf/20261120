prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include

Name: absl_btree_test_common
Description: Abseil btree_test_common library
URL: https://abseil.io/
Version: 20260107
Requires: absl_btree = 20260107, absl_cord = 20260107, absl_flat_hash_set = 20260107, absl_strings = 20260107, absl_time = 20260107
Libs: -L${libdir}  -Wl,--push-state,--as-needed -latomic -Wl,--pop-state
Cflags: -I${includedir} -DNOMINMAX
