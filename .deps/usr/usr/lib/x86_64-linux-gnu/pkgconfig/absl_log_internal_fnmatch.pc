prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include

Name: absl_log_internal_fnmatch
Description: Abseil log_internal_fnmatch library
URL: https://abseil.io/
Version: 20260107
Requires: absl_config = 20260107, absl_strings = 20260107
Libs: -L${libdir}  -labsl_log_internal_fnmatch -Wl,--push-state,--as-needed -latomic -Wl,--pop-state
Cflags: -I${includedir} -DNOMINMAX
