prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include

Name: absl_thread_pool
Description: Abseil thread_pool library
URL: https://abseil.io/
Version: 20260107
Requires: absl_any_invocable = 20260107, absl_core_headers = 20260107, absl_synchronization = 20260107
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
