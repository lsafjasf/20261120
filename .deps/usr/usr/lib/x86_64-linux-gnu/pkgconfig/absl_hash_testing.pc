prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include

Name: absl_hash_testing
Description: Abseil hash_testing library
URL: https://abseil.io/
Version: 20260107
Requires: absl_spy_hash_state = 20260107, absl_meta = 20260107, absl_strings = 20260107, absl_variant = 20260107
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
