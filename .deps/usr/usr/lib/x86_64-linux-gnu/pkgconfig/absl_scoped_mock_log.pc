prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include

Name: absl_scoped_mock_log
Description: Abseil scoped_mock_log library
URL: https://abseil.io/
Version: 20260107
Requires: absl_config = 20260107, absl_log_entry = 20260107, absl_log_severity = 20260107, absl_log_sink = 20260107, absl_log_sink_registry = 20260107, absl_raw_logging_internal = 20260107, absl_strings = 20260107
Libs: -L${libdir}  -labsl_scoped_mock_log -Wl,--push-state,--as-needed -latomic -Wl,--pop-state
Cflags: -I${includedir} -DNOMINMAX
