prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include

Name: absl_absl_check
Description: Abseil absl_check library
URL: https://abseil.io/
Version: 20260107
Requires: absl_log_internal_check_impl = 20260107
Libs: -L${libdir}  -Wl,--push-state,--as-needed -latomic -Wl,--pop-state
Cflags: -I${includedir} -DNOMINMAX
