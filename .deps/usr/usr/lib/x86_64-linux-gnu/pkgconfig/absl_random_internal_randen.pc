prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include

Name: absl_random_internal_randen
Description: Abseil random_internal_randen library
URL: https://abseil.io/
Version: 20260107
Requires: absl_random_internal_platform = 20260107, absl_random_internal_randen_hwaes = 20260107, absl_random_internal_randen_slow = 20260107
Libs: -L${libdir}  -labsl_random_internal_randen -Wl,--push-state,--as-needed -latomic -Wl,--pop-state
Cflags: -I${includedir} -DNOMINMAX
